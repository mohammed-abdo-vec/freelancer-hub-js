# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# The Vite dev server. Comma-separate to allow several origins.
CLIENT_ORIGIN=http://localhost:5173

# ── Security ────────────────────────────────────────────
# Signs session tokens. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Encrypts provider API keys at rest (AES-256-GCM). Any long random string.
# Changing it makes previously stored keys unreadable.
ENCRYPTION_KEY=change-me-to-another-long-random-string

# ── Storage ─────────────────────────────────────────────
# JSON file database, created on first run.
DATA_FILE=./data/db.json

# ── Features ────────────────────────────────────────────
# Adds a free "Mock AI" provider (any key starting with "mock-") so the
# frontend can be built and demoed without paying for a real provider.
ENABLE_MOCK_PROVIDER=true
